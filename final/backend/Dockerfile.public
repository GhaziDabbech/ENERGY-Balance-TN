# ── STEG Public Citizen API (Dockerfile.public) ──────────────────────────────
# Serves only the citizen portal endpoints on port 8001.
# Entry point: main_public.py — no scheduler, no WebSocket, no admin routes.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Public image needs redis + fastapi-cache2 on top of the base requirements
COPY requirements-public.txt .
RUN pip install --no-cache-dir -r requirements-public.txt

COPY . .

# No migration here — the internal container runs them first.
# The public container waits for the DB via the healthcheck in docker-compose.
CMD ["uvicorn", "main_public:app", "--host", "0.0.0.0", "--port", "8001"]
