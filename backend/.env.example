# Copy this file to backend/.env and adapt it. Never commit backend/.env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_balance_tn

# Secret used to sign login tokens. Use any long random text.
AUTH_SECRET=change-me-to-a-long-random-string

# Local AI model (Ollama)
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
